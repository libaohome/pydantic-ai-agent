# 复制为 .env 并填写。LLM 凭证与模型配置存于 SQLite（llm_credential_groups / llm_models 表）。

# ─── 可观测性 ─────────────────────────
LOGFIRE_TOKEN=

# ─── 数据库 ───────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# ─── 应用配置 ─────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
# 默认模型别名（对应 llm_models.alias；可省略，默认 deepseek-chat）
# DEFAULT_MODEL=deepseek-chat

# ─── MCP 服务器 ───────────────────────
MCP_FETCH_URL=
