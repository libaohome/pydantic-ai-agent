# 复制为 .env 并填写；以下键均为必填（未使用的 Provider 可留空 API Key，但 Base URL 仍需保留）

# ─── LLM 提供商 ─────────────────────────
DEEPSEEK_API_KEY=sk-xxx

LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai

AGNESAI_API_KEY=
AGNESAI_BASE_URL=https://apihub.agnes-ai.com/v1

SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

CLOUDFLARE_API_KEY=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# ─── 可观测性 ─────────────────────────
LOGFIRE_TOKEN=

# ─── 数据库 ───────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# ─── 应用配置 ─────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
DEFAULT_MODEL=deepseek:deepseek-chat

# ─── MCP 服务器 ───────────────────────
MCP_FETCH_URL=
